[Unit]
Description=MedNews API Server
After=network.target
Documentation=https://github.com/yourorg/mednews

[Service]
Type=simple
User=mednews
Group=mednews
# Note: setup.sh replaces User/Group above with the real username at install time
WorkingDirectory=/opt/mednews
EnvironmentFile=/opt/mednews/.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/mednews/.playwright-browsers
Environment=HOME=/opt/mednews
ExecStart=/opt/mednews/.venv/bin/uvicorn backend.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/mednews

[Install]
WantedBy=multi-user.target
