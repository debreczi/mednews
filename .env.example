# MedNews Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── AI Enrichment (LLM) ───────────────────────────────────────────────────────
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://your-endpoint.openai.azure.com/v1
LLM_MODEL=gpt-5.4-mini

# ── Scraping ───────────────────────────────────────────────────────────────────
# Minimum relevance score (1–10) for an article to be saved
RELEVANCE_THRESHOLD=6

# ── Database ───────────────────────────────────────────────────────────────────
DB_PATH=./mednews.db

# ── Admin ──────────────────────────────────────────────────────────────────────
# API key required in X-Admin-Key header for admin endpoints
ADMIN_API_KEY=change_me_to_a_strong_random_key

# ── Backend ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Frontend ───────────────────────────────────────────────────────────────────
# URL of the backend API, used by Vite at build time
VITE_API_BASE_URL=http://localhost:8000

# Admin key for frontend admin panel (used client-side — keep this secret)
VITE_ADMIN_API_KEY=change_me_to_a_strong_random_key
